# ──────────────────────────────────────────────
# Axon — Environment Variables
# Copy to .env.local and fill in real values.
# ──────────────────────────────────────────────

# Site URL (used for OG images, sitemap, emails)
NEXT_PUBLIC_SITE_URL=https://axonsecurity.tech

# ── SMTP (Neo email) ─────────────────────────
SMTP_HOST=smtp.neo.space
SMTP_PORT=465
SMTP_USER=you@axonsecurity.tech
SMTP_PASS=your-app-password

# ── Notification recipient ────────────────────
NOTIFICATION_TO=

# ── Cloudflare Turnstile (invisible CAPTCHA) ──
# Create a free account at https://dash.cloudflare.com → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAAA...
